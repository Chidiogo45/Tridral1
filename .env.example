# VITE_FORM_ENDPOINT (Optional): Client-side endpoint override for the Join Early Access form.
# Defaults to "/api/contact" (the Vercel Serverless Function in /api/contact.ts).
VITE_FORM_ENDPOINT="/api/contact"

# RESEND_API_KEY: Server-side only. Required for Vercel serverless email delivery to info@tridral.com.
# Configure this in Vercel Project Settings -> Environment Variables. Never expose in client code.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"

# RESEND_FROM_EMAIL (Optional): Verified sender address on tridral.com.
# Defaults to "Tridral Contact <contact@tridral.com>".
RESEND_FROM_EMAIL="Tridral Contact <contact@tridral.com>"

# VITE_BOOKING_URL (Optional): External scheduling URL (e.g. Cal.com or Calendly).
# When set, renders a secondary "Book a 30-minute call" pill button in the Early Access card.
VITE_BOOKING_URL=""
